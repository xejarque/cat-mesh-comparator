# Copia este fichero a .env y rellena los valores reales.
# systemd lo lee como EnvironmentFile (sin `export`, sin comillas necesarias).

CATMESH_MQTT_HOST=broker.example.cat
CATMESH_MQTT_PORT=8883
CATMESH_MQTT_TLS=true
CATMESH_MQTT_USERNAME=
CATMESH_MQTT_PASSWORD=
# Ruta al CA si el broker usa un certificado propio.
CATMESH_MQTT_CAFILE=

# Prefijo de los topics y código IATA del broker (ej. BCN).
CATMESH_TOPIC_PREFIX=meshcore
CATMESH_IATA=

CATMESH_DB=/opt/cat-mesh-comparator/data/catmesh.db

# Interfaz donde se publica la web. Por defecto todas, así que responde en
# http://<ip-del-host>:8000 sin tocar nada — igual que cualquier otro servicio.
#
# Solo hay que cambiarlo si quieres restringirla:
#
#   127.0.0.1    solo desde la propia máquina (útil si publicas con el perfil `tls`,
#                para que la única puerta desde internet sea Caddy)
#   100.x.y.z    solo por la interfaz de tu VPN
#
# CATMESH_BIND=0.0.0.0
CATMESH_PORT=8000

# Dominio público. Solo lo usa Caddy, que NO arranca salvo que actives el perfil
# `tls`. Si accedes por VPN puedes dejarlo como está.
CATMESH_SITE=localhost

# Túnel de Cloudflare: publica la web sin abrir puertos. Solo se usa con el perfil
# `tunnel`, así que si no lo activas puede quedarse vacío.
#
#   docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# A partir de cuántos segundos sin recibir nada se considera que el colector se ha
# parado. Lo usan el healthcheck de Docker y el aviso de la portada.
CATMESH_STALE_SECONDS=1800

# Cadencia de /status: a partir del doble, un paquete ya se marca dudoso.
CATMESH_STATUS_MAX_GAP_S=600
CATMESH_RAW_RETENTION_DAYS=30

# Enriquecer cada paquete decodificando su `raw` (path_length, payload_type, is_valid).
# Si falta meshcoredecoder, se avisa y se ingiere igual, sin enriquecer.
CATMESH_DECODE_PACKETS=true

# Cada cuánto se vacía el buffer a SQLite. 0 = escritura directa (un commit por
# mensaje, sin buffer).
#
# OJO: esto NO decide la frescura de ruido ni ocupación. Las publica la fuente en
# /status cada 300 s; bajarlo a 0 no las refresca. Solo cambia cuánto se pierde si
# el proceso muere de golpe.
CATMESH_FLUSH_INTERVAL_S=5.0

# Cada cuánto se recalculan los agregados (preset_minute/hour/day, pares, calidad)
# y se podan los paquetes crudos que superan CATMESH_RAW_RETENTION_DAYS.
CATMESH_ROLLUP_INTERVAL_S=300.0

# Directorio de copias. Por defecto, uno escribible por el usuario catmesh.
# Si lo cambias a /var/backups/..., dale la propiedad a catmesh.
CATMESH_BACKUP_DIR=/opt/cat-mesh-comparator/backups

# Solo para scripts/capture-sample.sh (Fase 0).
CATMESH_SAMPLE_SECONDS=600
